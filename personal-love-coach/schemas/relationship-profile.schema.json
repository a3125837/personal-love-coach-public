{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Relationship profile",
  "type": "object",
  "required": [
    "id",
    "alias",
    "revision",
    "updated_at",
    "stage",
    "status",
    "facts",
    "impressions",
    "stage_history"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "alias": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "stage": {
      "enum": [
        "unknown",
        "R0",
        "R1",
        "R2",
        "R3",
        "R4",
        "R5",
        "R6"
      ]
    },
    "status": {
      "enum": [
        "active",
        "paused",
        "ended"
      ]
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text",
          "source",
          "observed_at"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "observed_at": {
            "type": "string",
            "format": "date"
          }
        },
        "additionalProperties": false
      }
    },
    "impressions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stage_history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "stage",
          "date",
          "evidence"
        ],
        "properties": {
          "stage": {
            "enum": [
              "unknown",
              "R0",
              "R1",
              "R2",
              "R3",
              "R4",
              "R5",
              "R6"
            ]
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "next_action": {
      "type": [
        "string",
        "null"
      ]
    },
    "change_reason": {
      "type": "string"
    },
    "relationship_phase": {
      "enum": [
        "unknown",
        "P1",
        "P2",
        "P3",
        "P4",
        "P5",
        "P6",
        "P7",
        "P8"
      ]
    },
    "phase_history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "phase",
          "date",
          "evidence"
        ],
        "properties": {
          "phase": {
            "enum": [
              "unknown",
              "P1",
              "P2",
              "P3",
              "P4",
              "P5",
              "P6",
              "P7",
              "P8"
            ]
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "dependentRequired": {
    "relationship_phase": [
      "phase_history"
    ],
    "phase_history": [
      "relationship_phase"
    ]
  }
}
