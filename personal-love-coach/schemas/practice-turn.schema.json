{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "round_id",
    "case_id",
    "turn",
    "role",
    "text",
    "date",
    "simulation"
  ],
  "properties": {
    "round_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "turn": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9999
    },
    "role": {
      "enum": [
        "assistant",
        "user"
      ]
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "simulation": {
      "const": true
    }
  },
  "additionalProperties": false
}
