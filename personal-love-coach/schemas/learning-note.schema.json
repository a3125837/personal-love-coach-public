{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "round_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "case_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "case_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "first_answer_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "kind": {
          "const": "reflection"
        },
        "analysis": {
          "type": "string",
          "minLength": 1
        },
        "assistance": {
          "enum": [
            "unassisted",
            "assisted",
            "unknown"
          ]
        }
      },
      "required": [
        "id",
        "round_id",
        "case_id",
        "date",
        "kind",
        "analysis"
      ],
      "additionalProperties": false
    },
